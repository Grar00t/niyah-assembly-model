# Requires the trusted exactcalc sibling in the same output directory.
.PHONY: nexus-audit test-nexus-audit
build/nexus_audit: src/nexus_audit.s build/exactcalc
	mkdir -p build
	$(CC) -nostdlib -static -no-pie -Wl,--build-id=none -o $@ $<
nexus-audit: build/nexus_audit
test-nexus-audit: build/nexus_audit
	python3 tests/test_nexus_audit.py
